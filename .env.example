# ---------------------------------------------------------------
# Kairo environment
# Copy to .env.local. Every value is OPTIONAL — Kairo runs fully
# without any keys using its built-in strategy and design engines.
# ---------------------------------------------------------------

# Signs session cookies. Set a long random string in production.
AUTH_SECRET=

# Public URL, used for metadata and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Image generation (first configured provider wins) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Video generation ---
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=
HIGGSFIELD_VIDEO_URL=

# --- Copy refinement (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
