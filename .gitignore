# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Kairo local data and uploads
/data
/public/uploads/*
!/public/uploads/.gitkeep
.env.local


.vercel
.env*

# .env.example carries no secrets and documents the optional keys.
# This negation must stay below the .env* rule above, or it is overridden.
!.env.example

# Generated marketing renders. These are 4K PNGs — a few hundred megabytes per
# set — and they are produced on demand, so they do not belong in the history.
/carousel-en
/carousel-v2
/carousel-dir
/coming-soon

# 4K source renders for the mascot. The shipped assets are public/kai/*.webp.
/kai-src
